# StoryFund environment — copy to .env.local and fill in values.
# NEVER put private keys (S...) in NEXT_PUBLIC_* variables or commit secrets.

# testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# StoryFund contract ID (set after deploy via scripts/deploy-contract.sh)
NEXT_PUBLIC_CONTRACT_ID=

# SEP-41 token used for escrow (Circle USDC SAC on Testnet by default)
NEXT_PUBLIC_TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Optional — only for local deploy scripts (NEVER expose to the browser)
# STELLAR_SECRET_KEY=
# STELLAR_NETWORK=testnet
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# TOKEN_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# DEFAULT_REVIEW_WINDOW=172800
